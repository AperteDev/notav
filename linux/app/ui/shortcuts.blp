using Gtk 4.0;
using Adw 1;

// Keyboard Shortcuts (Ctrl+?). Window-wide ones show the keys set in code by their action.
Adw.ShortcutsDialog dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("New Note");
      action-name: "win.new-note";
    }

    Adw.ShortcutsItem {
      title: _("Today’s Note");
      action-name: "win.daily-note";
    }

    Adw.ShortcutsItem {
      title: _("Search Notes");
      action-name: "win.search";
    }

    Adw.ShortcutsItem {
      title: _("Undo Delete or Move");
      action-name: "win.undo";
    }

    Adw.ShortcutsItem {
      title: _("Sync");
      action-name: "app.sync";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "win.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }

  // AdwTabView's own keys, but for Ctrl+W.
  Adw.ShortcutsSection {
    title: _("Tabs");

    Adw.ShortcutsItem {
      title: _("Next Tab");
      accelerator: "<Control>Page_Down";
    }

    Adw.ShortcutsItem {
      title: _("Previous Tab");
      accelerator: "<Control>Page_Up";
    }

    Adw.ShortcutsItem {
      title: _("Move Tab Right");
      accelerator: "<Shift><Control>Page_Down";
    }

    Adw.ShortcutsItem {
      title: _("Move Tab Left");
      accelerator: "<Shift><Control>Page_Up";
    }

    Adw.ShortcutsItem {
      title: _("Close Tab");
      action-name: "win.close-tab";
    }
  }

  Adw.ShortcutsSection {
    title: _("Editor");

    Adw.ShortcutsItem {
      title: _("Undo");
      accelerator: "<Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Redo");
      accelerator: "<Shift><Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Find");
      action-name: "win.find";
    }

    Adw.ShortcutsItem {
      title: _("Find and Replace");
      action-name: "win.find-replace";
    }

    Adw.ShortcutsItem {
      title: _("Next Match");
      action-name: "win.find-next";
    }

    Adw.ShortcutsItem {
      title: _("Previous Match");
      action-name: "win.find-previous";
    }

    Adw.ShortcutsItem {
      title: _("Open the Link at the Cursor");
      accelerator: "<Alt>Return";
    }

    Adw.ShortcutsItem {
      title: _("Next Table Cell");
      accelerator: "Tab";
    }

    Adw.ShortcutsItem {
      title: _("Previous Table Cell");
      accelerator: "<Shift>Tab";
    }

    Adw.ShortcutsItem {
      title: _("Next Table Row");
      accelerator: "Return";
    }

    Adw.ShortcutsItem {
      title: _("Larger Text");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: _("Smaller Text");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: _("Reset Text Size");
      action-name: "win.zoom-reset";
    }
  }
}
