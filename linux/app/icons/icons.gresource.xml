<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <!-- The app's own icon, for the About dialog when it is not installed (a build run). -->
  <gresource prefix="/dev/aperte/Notav/icons/scalable/apps">
    <file alias="dev.aperte.Notav.svg">../../data/dev.aperte.Notav.svg</file>
  </gresource>
  <!-- Icons of the app's own, found by name: GTK looks under the app's resource path. -->
  <gresource prefix="/dev/aperte/Notav/icons/scalable/actions">
    <file>notav-today-symbolic.svg</file>
    <file>notav-editor-mode-symbolic.svg</file>
    <file>notav-source-mode-symbolic.svg</file>
  </gresource>
  <!-- What the About dialog shows (Adw.AboutDialog.new_from_appdata): the metainfo with its
       translations, as build.rs writes it to OUT_DIR. -->
  <gresource prefix="/dev/aperte/Notav">
    <file alias="metainfo.xml">dev.aperte.Notav.metainfo.xml</file>
  </gresource>
  <!-- The editor's Markdown and its style schemes (window.rs adds these to the search paths). -->
  <gresource prefix="/dev/aperte/Notav/sourceview">
    <file alias="notav-markdown.lang">../sourceview/notav-markdown.lang</file>
    <file alias="notav.xml">../sourceview/notav.xml</file>
    <file alias="notav-dark.xml">../sourceview/notav-dark.xml</file>
  </gresource>
</gresources>
