<?xml version="1.0" encoding="UTF-8"?>
<!-- Adwaita's colours for prose rather than code, as Iotas styles its notes: headings sized by
     level, the Markdown marks dimmed, links in blue. -->
<style-scheme id="notav-dark" name="Notav Dark" parent-scheme="Adwaita-dark" version="1.0">
  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">notav</property>
  </metadata>

  <style name="notav-markdown:heading1"       foreground="#F6F5F4" bold="true" scale="1.5"/>
  <style name="notav-markdown:heading2"       foreground="#F6F5F4" bold="true" scale="1.3"/>
  <style name="notav-markdown:heading3"       foreground="#F6F5F4" bold="true" scale="1.15"/>
  <style name="notav-markdown:heading4"       foreground="#F6F5F4" bold="true" scale="1.05"/>
  <style name="notav-markdown:heading5"       foreground="#F6F5F4" bold="true"/>
  <style name="notav-markdown:heading6"       foreground="#F6F5F4" bold="true"/>
  <style name="notav-markdown:heading-markup" foreground="#77767B"/>

  <!-- Setext underlines, and "#tag" at the start of a line. -->
  <style name="markdown:header"               foreground="#77767B" bold="true"/>
  <style name="markdown:list-marker"          foreground="#77767B" bold="true"/>
  <style name="markdown:blockquote-marker"    foreground="#77767B" bold="true"/>
  <style name="markdown:horizontal-rule"      foreground="#77767B" bold="true"/>
  <style name="markdown:image-marker"         foreground="#77767B" bold="true"/>
  <style name="markdown:link-text"            foreground="#62A0EA"/>
  <style name="markdown:url"                  foreground="#77767B" italic="true" underline="low"/>

  <!-- Editor mode (src/editor.rs), headings as above. -->
  <style name="notav-editor:strong"           bold="true"/>
  <style name="notav-editor:emphasis"         italic="true"/>
  <style name="notav-editor:strikethrough"    strikethrough="true"/>
  <style name="notav-editor:code"             background="#38383D"/>
  <style name="notav-editor:code-block"       line-background="#2A2A2E"/>
  <style name="notav-editor:quote"            foreground="#C0BFBC"/>
  <style name="notav-editor:link"             foreground="#62A0EA" underline="single"/>
  <style name="notav-editor:list-mark"        foreground="#77767B" bold="true"/>
  <style name="notav-editor:task"             foreground="#62A0EA" bold="true"/>
  <style name="notav-editor:table-header"     bold="true"/>
  <style name="notav-editor:mark"             foreground="#77767B"/>
</style-scheme>
