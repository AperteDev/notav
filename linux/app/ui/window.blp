using Gtk 4.0;
using Adw 1;
using GtkSource 5;

Adw.ApplicationWindow window {
  title: "Notav";
  default-width: 1000;
  default-height: 700;
  // Closing hides it while what waits for the server goes up (`quit_after_sync`).
  hide-on-close: true;

  content: Adw.ToastOverlay toasts {
    Gtk.Stack stack {
      Gtk.StackPage {
        name: "welcome";

        // The first account to add (ui/add-account.blp, set in src/window.rs `welcome`).
        child: Adw.Bin welcome {};
      }

      Gtk.StackPage {
        name: "main";

        // As Todav's: the sidebar hidden with its button (F9), and by itself on a narrow window,
        // where it then shows over the note.
        child: Adw.OverlaySplitView split {
          min-sidebar-width: 260;
          max-sidebar-width: 340;

          // The notes as a tree of folders and files, as Obsidian shows them (src/window.rs
          // `refresh_tree`).
          sidebar: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle {
                  title: "Notav";
                };

                [end]
                Gtk.MenuButton {
                  icon-name: "open-menu-symbolic";
                  menu-model: main_menu;
                  tooltip-text: _("Main Menu");
                  primary: true;
                }

                [end]
                Gtk.ToggleButton search_button {
                  icon-name: "notav-folder-search-symbolic";
                  tooltip-text: _("Search Notes (Ctrl+Shift+F)");
                }
              }

              // While something is typed, the matching notes take the tree's place, as a tree of
              // their own (src/window.rs `refresh_results`): the notes' tree stays as it was.
              [top]
              Gtk.SearchBar search_bar {
                search-mode-enabled: bind search_button.active bidirectional;

                Gtk.SearchEntry search {
                  placeholder-text: _("Search notes");
                  hexpand: true;
                }
              }

              content: Gtk.Stack tree_stack {
                Gtk.StackPage {
                  name: "tree";
                  // Notes dropped below the last row go to the top level (src/window.rs).
                  child: Gtk.ScrolledWindow tree_scroll {
                    vexpand: true;
                    hscrollbar-policy: never;

                    Gtk.ListBox tree {
                      styles ["navigation-sidebar"]
                    }
                  };
                }

                Gtk.StackPage {
                  name: "empty";
                  child: Adw.StatusPage {
                    icon-name: "folder-documents-symbolic";
                    title: _("No Notes");
                    description: _("Add one with Ctrl+N");
                    styles ["compact"]
                  };
                }

                Gtk.StackPage {
                  name: "results";
                  child: Gtk.ScrolledWindow {
                    vexpand: true;
                    hscrollbar-policy: never;

                    Gtk.ListBox results {
                      styles ["navigation-sidebar"]
                    }
                  };
                }

                Gtk.StackPage {
                  name: "no-results";
                  child: Adw.StatusPage {
                    icon-name: "system-search-symbolic";
                    title: _("No Results");
                    styles ["compact"]
                  };
                }
              };
          };

          content: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle note_title {};

                [start]
                Gtk.ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Toggle Sidebar (F9)");
                  active: bind split.show-sidebar bidirectional;
                }

                [start]
                Gtk.Button {
                  icon-name: "document-new-symbolic";
                  tooltip-text: _("New Note (Ctrl+N)");
                  action-name: "win.new-note";
                }

                // The journal's note of today, made if there is none.
                [start]
                Gtk.Button {
                  icon-name: "notav-today-symbolic";
                  tooltip-text: _("Today’s Note (Ctrl+T)");
                  action-name: "win.daily-note";
                }

                // The outline panel at the window's edge, above it (the device-only
                // `show_outline` setting).
                [end]
                Gtk.ToggleButton outline_button {
                  icon-name: "sidebar-show-right-symbolic";
                  tooltip-text: _("Outline");
                }

                // Font size and the text area's width, for this device.
                [end]
                Gtk.MenuButton {
                  icon-name: "view-more-symbolic";
                  tooltip-text: _("View Options");

                  // The builder sets the menu after the children: the zoom row is added to it in
                  // code (`zoom_box`).
                  popover: Gtk.PopoverMenu view_popover {
                    menu-model: view_menu;

                    [zoom]
                    Gtk.Box zoom_box {
                      homogeneous: true;
                      margin-start: 6;
                      margin-end: 6;

                      Gtk.Button {
                        icon-name: "zoom-out-symbolic";
                        tooltip-text: _("Smaller Text (Ctrl+−)");
                        action-name: "win.zoom-out";
                        styles ["flat"]
                      }

                      // As wide as "300%" whatever it shows, so the menu keeps its width.
                      Gtk.Button {
                        tooltip-text: _("Reset Text Size (Ctrl+0)");
                        action-name: "win.zoom-reset";
                        styles ["flat"]

                        Gtk.Label zoom_reset {
                          label: "100%";
                          width-chars: 5;
                        }
                      }

                      Gtk.Button {
                        icon-name: "zoom-in-symbolic";
                        tooltip-text: _("Larger Text (Ctrl++)");
                        action-name: "win.zoom-in";
                        styles ["flat"]
                      }
                    }
                  };
                }

                // Editor mode or Source mode (the device-only `source_mode` setting).
                [end]
                Adw.ToggleGroup note_mode {
                  valign: center;

                  Adw.Toggle {
                    name: "editor";
                    icon-name: "notav-editor-mode-symbolic";
                    tooltip: _("Editor Mode");
                  }

                  Adw.Toggle {
                    name: "source";
                    icon-name: "notav-source-mode-symbolic";
                    tooltip: _("Source Mode");
                  }
                }

                // The icon, or a spinner while syncing.
                [end]
                Gtk.Button {
                  tooltip-text: _("Sync (F5)");
                  action-name: "app.sync";
                  styles ["image-button"]

                  Gtk.Stack sync_state {
                    transition-type: crossfade;

                    Gtk.StackPage {
                      name: "idle";
                      child: Gtk.Image {
                        icon-name: "view-refresh-symbolic";
                      };
                    }

                    Gtk.StackPage {
                      name: "syncing";
                      child: Adw.Spinner {};
                    }
                  }
                }

                // Only while a note is open (src/window.rs `show_page`).
                [end]
                Gtk.ToggleButton find_button {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Find in Note (Ctrl+F)");
                }
              }

              // The open notes, as Obsidian's tabs (src/window.rs `open_note_in`); shown with two
              // or more. Their view shows nothing itself (its pages are empty, so it takes no
              // room): the one editor below shows the selected tab's note. Not hidden, as hidden
              // it takes no keys (Ctrl+Page Down and the like).
              [top]
              Adw.TabBar {
                view: tabs;
              }

              [top]
              Adw.TabView tabs {}

              // A newer version installed (src/update.rs, src/window.rs `update_banner`).
              [top]
              Adw.Banner update_banner {
                title: _("Notav was updated: restart it to use the new version");
                button-label: _("Restart");
                action-name: "app.restart";
              }

              // Find and replace in the open note, GtkSourceView's search (src/window.rs
              // `connect_find`).
              [top]
              Gtk.SearchBar find_bar {
                search-mode-enabled: bind find_button.active bidirectional;
                Adw.Clamp {
                  maximum-size: 860;
                  hexpand: true;

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 6;

                    Gtk.Box {
                      spacing: 6;

                      Gtk.SearchEntry find {
                        placeholder-text: _("Find in note");
                        hexpand: true;
                      }

                      Gtk.Label find_count {
                        styles ["dim-label", "numeric"]
                      }

                      Gtk.Box {
                        styles ["linked"]

                        Gtk.Button {
                          icon-name: "go-up-symbolic";
                          tooltip-text: _("Previous Match (Ctrl+Shift+G)");
                          action-name: "win.find-previous";
                        }

                        Gtk.Button {
                          icon-name: "go-down-symbolic";
                          tooltip-text: _("Next Match (Ctrl+G)");
                          action-name: "win.find-next";
                        }
                      }

                      Gtk.ToggleButton replace_button {
                        icon-name: "edit-find-replace-symbolic";
                        tooltip-text: _("Replace (Ctrl+H)");
                      }
                    }

                    Gtk.Box {
                      spacing: 6;
                      visible: bind replace_button.active;

                      Gtk.Entry replace {
                        placeholder-text: _("Replace with");
                        hexpand: true;

                        accessibility {
                          label: _("Replace with");
                        }
                      }

                      Gtk.Button {
                        label: _("_Replace");
                        use-underline: true;
                        action-name: "win.replace";
                      }

                      Gtk.Button {
                        label: _("Replace _All");
                        use-underline: true;
                        action-name: "win.replace-all";
                      }
                    }
                  }
                }
              }

              // Without Wrap Lines, the note's text scrolls sideways by itself (only it, not the
              // title): its scrollbar, shown while a line is longer than the view
              // (`show_side_scroll`).
              [bottom]
              Gtk.Scrollbar side_scroll {
                orientation: horizontal;
                visible: false;
              }

              // The open note's headings at its right; a click goes to one (src/window.rs
              // `refresh_outline`).
              content: Adw.OverlaySplitView outline_split {
                sidebar-position: end;
                show-sidebar: bind outline_button.active bidirectional;
                min-sidebar-width: 200;
                max-sidebar-width: 280;

                sidebar: Gtk.ScrolledWindow {
                  hscrollbar-policy: never;

                  Gtk.ListBox outline {
                    selection-mode: none;
                    styles ["navigation-sidebar"]
                  }
                };

                content: Gtk.Stack note_stack {
                  Gtk.StackPage {
                    name: "none";
                    child: Adw.StatusPage {
                      icon-name: "dev.aperte.Notav-symbolic";
                      title: _("No Note Selected");
                      description: _("Pick a note or add one with Ctrl+N");
                    };
                  }

                  Gtk.StackPage {
                    name: "note";
                    // The editor's background all the way, as in GNOME Text Editor.
                    child: Gtk.ScrolledWindow note_scroll {
                      vexpand: true;
                      styles ["view"]

                      // Not to the focused widget: focusing the note's text would show its end.
                      // The text follows its cursor in code (`follow_cursor`).
                      Gtk.Viewport {
                        scroll-to-focus: false;

                        // A line of about 80 characters, as Folio (720) and Iotas (800) keep it;
                        // all the width with Full Width (`apply_text_look`).
                        Adw.Clamp note_clamp {
                          maximum-size: 720;
                          tightening-threshold: 600;

                          Gtk.Box note_box {
                            orientation: vertical;
                            margin-top: 18;
                            margin-bottom: 18;
                            margin-start: 12;
                            margin-end: 12;
                            spacing: 6;

                            // The file name: renames the note when changed.
                            Gtk.Entry title {
                              placeholder-text: _("Title");
                              styles ["flat", "note-title"]
                            }

                            // Its own scrolling sideways only (the side scrollbar, shown at the
                            // bottom instead), so the text's width does not follow what it holds:
                            // a table's handles, as wide as the table, would widen the note.
                            Gtk.ScrolledWindow {
                              hscrollbar-policy: external;
                              vscrollbar-policy: never;
                              vexpand: true;

                              GtkSource.View editor {
                                wrap-mode: word_char;
                                top-margin: 6;
                                bottom-margin: 48;
                                left-margin: 6;
                                right-margin: 6;
                                styles ["note-text"]
                              }
                            }

                            // The notes linking to this one, under its text (`show_backlinks`).
                            Gtk.Box backlinks_box {
                              orientation: vertical;
                              spacing: 12;
                              visible: false;

                              Gtk.Label backlinks_title {
                                xalign: 0;
                                margin-start: 6;
                                styles ["heading"]
                              }

                              Gtk.ListBox backlinks {
                                selection-mode: none;
                                styles ["boxed-list"]
                              }
                            }
                          }
                        }
                      }
                    };
                  }
                };
              };
            };
          };
      }
    }
  };

  // One breakpoint applies at a time, the last that matches: the narrower last, with the wider
  // one's setters too.

  // Narrower, the outline covers the note instead of taking its room.
  Adw.Breakpoint {
    condition ("max-width: 900sp")

    setters {
      outline_split.collapsed: true;
    }
  }

  // As Todav's: narrower still, the sidebar hides too (collapsing hides it, widening shows it
  // again), and shows over the note.
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      outline_split.collapsed: true;
      split.collapsed: true;
    }
  }
}

menu view_menu {
  section {
    item {
      custom: "zoom";
    }
  }

  section {
    item (_("Wrap Lines"), "win.wrap-lines")
    item (_("Full Width"), "win.full-width")
  }
}

menu main_menu {
  // Only where the server keeps deleted notes (src/window.rs `enable_trash`).
  item {
    label: _("Trash");
    action: "win.trash";
    hidden-when: "action-disabled";
  }

  item (_("Preferences"), "win.preferences")
  item (_("Keyboard Shortcuts"), "app.shortcuts")
  item (_("About Notav"), "app.about")
  item (_("Quit"), "app.quit")
}
