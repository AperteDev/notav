// Run the Linux app straight from the workspace, without `make install`.
// The app is single-instance: if another copy (installed or a previous run) owns
// the bus name, a new launch just forwards to it. Quit it first with the task below.
[
  {
    "label": "linux: run",
    "command": "cargo run -p notav-linux",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run (release)",
    "command": "cargo run --release -p notav-linux",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run with debug logs",
    "command": "cargo run -p notav-linux",
    "env": { "G_MESSAGES_DEBUG": "all", "RUST_BACKTRACE": "1" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run in browser (Broadway)",
    // In make, not here: Zed runs commands through the user's shell (fish), not sh.
    "command": "make -C notav/linux broadway",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run in sandbox",
    // Own data and keyring entries, next to the normal app: for testing other connections.
    "command": "make -C notav/linux sandbox",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: reset sandbox",
    "command": "make -C notav/linux sandbox-reset",
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "linux: quit running instance",
    // --auto-start=no so this never D-Bus-activates an installed copy just to quit it.
    "command": "busctl --user --auto-start=no call dev.aperte.Notav /dev/aperte/Notav org.gtk.Actions Activate 'sava{sv}' quit 0 0 || true",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "android: run on emulator",
    // Starts the emulator if needed (sdk.sh), builds for its ABI, installs and opens the app.
    "command": "make -C notav/android run",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "android: follow app log",
    "command": "make -C notav/android logs",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "android: build APKs",
    // Debug APK for every ABI, in notav/android/app/build/outputs/apk/debug/.
    "command": "make -C notav/android build",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "android: stop emulator",
    "command": "make -C notav/android stop",
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "android: fold emulator",
    // The foldable emulator closed, the app on its cover screen as on a phone.
    "command": "make -C notav/android fold",
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "android: unfold emulator",
    "command": "make -C notav/android unfold",
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "android: set up SDK and emulator",
    // The SDK in ~/Android/Sdk shared with Todav, with the versions gradle.properties names.
    "command": "make -C notav/android setup",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
