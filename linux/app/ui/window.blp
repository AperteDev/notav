using Gtk 4.0;
using Adw 1;
using GtkSource 5;

Adw.ApplicationWindow window {
  title: "Notav";
  default-width: 1000;
  default-height: 700;
  // Closing hides it while what waits for the server goes up (`quit_after_sync`).
  hide-on-close: true;

  content: Adw.ToastOverlay toasts {
    Gtk.Stack stack {
      Gtk.StackPage {
        name: "welcome";

        // How to connect, the account, then the notes folder (src/window.rs `connect_welcome`).
        child: Adw.NavigationView welcome {
          Adw.NavigationPage {
            tag: "choose";
            title: "Notav";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-title: false;
              }

              content: Adw.StatusPage {
                icon-name: "dev.aperte.Notav";
                title: "Notav";
                description: _("Notes and a journal kept as Markdown files in your Nextcloud");
                styles ["compact"]

                Adw.Clamp {
                  maximum-size: 420;

                  Gtk.ListBox {
                    selection-mode: none;
                    styles ["boxed-list"]

                    Adw.ActionRow use_goa {
                      title: _("GNOME Online Accounts");
                      activatable: true;

                      [prefix]
                      Gtk.Image {
                        icon-name: "goa-panel-symbolic";
                      }

                      [suffix]
                      Gtk.Image {
                        icon-name: "go-next-symbolic";
                      }
                    }

                    Adw.ActionRow use_server {
                      title: _("Nextcloud Server");
                      subtitle: _("Sign in with the browser or an app password");
                      activatable: true;

                      [prefix]
                      Gtk.Image {
                        icon-name: "network-server-symbolic";
                      }

                      [suffix]
                      Gtk.Image {
                        icon-name: "go-next-symbolic";
                      }
                    }
                  }
                }
              };
            };
          }

          // The GOA account or the server, as chosen; its title is set in code.
          Adw.NavigationPage connect_page {
            tag: "connect";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              content: Adw.StatusPage connect_status {
                styles ["compact"]

                Adw.Clamp {
                  maximum-size: 420;

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 24;

                    // Filled with the shared connection rows (ui/connection.blp).
                    Adw.PreferencesGroup login_group {}

                    Gtk.Box {
                      orientation: vertical;
                      spacing: 6;

                      Gtk.Button connect_goa {
                        label: _("Connect");
                        halign: center;
                        styles ["suggested-action", "pill"]
                      }

                      Adw.SplitButton login {
                        label: _("Sign In with Browser");
                        menu-model: login_menu;
                        dropdown-tooltip: _("More Sign-In Options");
                        halign: center;
                        styles ["suggested-action", "pill"]
                      }

                      Gtk.Button cancel_login {
                        label: _("Cancel");
                        halign: center;
                        visible: false;
                        styles ["flat"]
                      }
                    }
                  }
                }
              };
            };
          }

          // Where the notes are, once connected; suggested from the server (src/window.rs).
          Adw.NavigationPage {
            tag: "folder";
            title: _("Notes Folder");
            can-pop: false;

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              content: Adw.StatusPage {
                icon-name: "folder-documents-symbolic";
                title: _("Notes Folder");
                description: _("The folder in Nextcloud Files your notes are kept in. The Nextcloud Notes app uses the same one; it is created if it does not exist.");
                styles ["compact"]

                Adw.Clamp {
                  maximum-size: 420;

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 24;

                    Adw.PreferencesGroup {
                      Adw.EntryRow folder {
                        title: _("Folder");
                        activates-default: true;
                      }
                    }

                    Gtk.Button folder_done {
                      label: _("Continue");
                      halign: center;
                      styles ["suggested-action", "pill"]
                    }
                  }
                }
              };
            };
          }
        };
      }

      Gtk.StackPage {
        name: "main";

        child: Adw.NavigationSplitView split {
          min-sidebar-width: 260;
          max-sidebar-width: 340;

          // The notes as a tree of folders and files, as Obsidian shows them (src/window.rs
          // `refresh_tree`).
          sidebar: Adw.NavigationPage {
            title: "Notav";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                Gtk.MenuButton {
                  icon-name: "open-menu-symbolic";
                  menu-model: main_menu;
                  tooltip-text: _("Main Menu");
                  primary: true;
                }
              }

              content: Gtk.Stack tree_stack {
                Gtk.StackPage {
                  name: "tree";
                  // Notes dropped below the last row go to the top level (src/window.rs).
                  child: Gtk.ScrolledWindow tree_scroll {
                    vexpand: true;
                    hscrollbar-policy: never;

                    Gtk.ListBox tree {
                      styles ["navigation-sidebar"]
                    }
                  };
                }

                Gtk.StackPage {
                  name: "empty";
                  child: Adw.StatusPage {
                    icon-name: "folder-documents-symbolic";
                    title: _("No Notes");
                    description: _("Add one with Ctrl+N");
                    styles ["compact"]
                  };
                }
              };
            };
          };

          content: Adw.NavigationPage {
            title: _("Note");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Adw.WindowTitle note_title {};

                [start]
                Gtk.Button {
                  icon-name: "document-new-symbolic";
                  tooltip-text: _("New Note (Ctrl+N)");
                  action-name: "win.new-note";
                }

                // Font size and the text area's width, for this device.
                [end]
                Gtk.MenuButton {
                  icon-name: "view-more-symbolic";
                  tooltip-text: _("View Options");

                  // The builder sets the menu after the children: the zoom row is added to it in
                  // code (`zoom_box`).
                  popover: Gtk.PopoverMenu view_popover {
                    menu-model: view_menu;

                    [zoom]
                    Gtk.Box zoom_box {
                      homogeneous: true;
                      margin-start: 6;
                      margin-end: 6;

                      Gtk.Button {
                        icon-name: "zoom-out-symbolic";
                        tooltip-text: _("Smaller Text (Ctrl+−)");
                        action-name: "win.zoom-out";
                        styles ["flat"]
                      }

                      // As wide as "300%" whatever it shows, so the menu keeps its width.
                      Gtk.Button {
                        tooltip-text: _("Reset Text Size (Ctrl+0)");
                        action-name: "win.zoom-reset";
                        styles ["flat"]

                        Gtk.Label zoom_reset {
                          label: "100%";
                          width-chars: 5;
                        }
                      }

                      Gtk.Button {
                        icon-name: "zoom-in-symbolic";
                        tooltip-text: _("Larger Text (Ctrl++)");
                        action-name: "win.zoom-in";
                        styles ["flat"]
                      }
                    }
                  };
                }

                // Editor mode or Source mode (the device-only `source_mode` setting).
                [end]
                Adw.ToggleGroup note_mode {
                  valign: center;

                  Adw.Toggle {
                    name: "editor";
                    icon-name: "format-text-rich-symbolic";
                    tooltip: _("Editor Mode");
                  }

                  Adw.Toggle {
                    name: "source";
                    icon-name: "format-text-plaintext-symbolic";
                    tooltip: _("Source Mode");
                  }
                }

                // The icon, or a spinner while syncing.
                [end]
                Gtk.Button {
                  tooltip-text: _("Sync (F5)");
                  action-name: "app.sync";
                  styles ["image-button"]

                  Gtk.Stack sync_state {
                    transition-type: crossfade;

                    Gtk.StackPage {
                      name: "idle";
                      child: Gtk.Image {
                        icon-name: "view-refresh-symbolic";
                      };
                    }

                    Gtk.StackPage {
                      name: "syncing";
                      child: Adw.Spinner {};
                    }
                  }
                }

                [end]
                Gtk.ToggleButton search_button {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search (Ctrl+F)");
                }
              }

              // While something is typed, the matching notes take the editor's place.
              [top]
              Gtk.SearchBar search_bar {
                search-mode-enabled: bind search_button.active bidirectional;

                Adw.Clamp {
                  maximum-size: 860;
                  hexpand: true;

                  Gtk.SearchEntry search {
                    placeholder-text: _("Search notes");
                    hexpand: true;
                  }
                }
              }

              content: Gtk.Stack note_stack {
                Gtk.StackPage {
                  name: "none";
                  child: Adw.StatusPage {
                    icon-name: "dev.aperte.Notav-symbolic";
                    title: _("No Note Selected");
                    description: _("Pick a note or add one with Ctrl+N");
                  };
                }

                Gtk.StackPage {
                  name: "results";
                  child: Gtk.Stack results_stack {
                    Gtk.StackPage {
                      name: "list";
                      child: Gtk.ScrolledWindow {
                        vexpand: true;

                        Adw.Clamp {
                          maximum-size: 860;

                          Gtk.ListBox results {
                            selection-mode: none;
                            valign: start;
                            margin-top: 12;
                            margin-bottom: 24;
                            margin-start: 12;
                            margin-end: 12;
                            styles ["boxed-list"]
                          }
                        }
                      };
                    }

                    Gtk.StackPage {
                      name: "none";
                      child: Adw.StatusPage {
                        icon-name: "system-search-symbolic";
                        title: _("No Results");
                      };
                    }
                  };
                }

                Gtk.StackPage {
                  name: "note";
                  // The editor's background all the way, as in GNOME Text Editor.
                  child: Gtk.ScrolledWindow note_scroll {
                    vexpand: true;
                    styles ["view"]

                    // Not to the focused widget: focusing the note's text would show its end.
                    // The text follows its cursor in code (`follow_cursor`).
                    Gtk.Viewport {
                      scroll-to-focus: false;

                      // A line of about 80 characters, as Folio (720) and Iotas (800) keep it;
                      // all the width with Full Width (`apply_text_look`).
                      Adw.Clamp note_clamp {
                        maximum-size: 720;
                        tightening-threshold: 600;

                        Gtk.Box note_box {
                          orientation: vertical;
                          margin-top: 18;
                          margin-bottom: 18;
                          margin-start: 12;
                          margin-end: 12;
                          spacing: 6;

                          // The file name: renames the note when changed.
                          Gtk.Entry title {
                            placeholder-text: _("Title");
                            styles ["flat", "note-title"]
                          }

                          GtkSource.View editor {
                            vexpand: true;
                            wrap-mode: word_char;
                            top-margin: 6;
                            bottom-margin: 48;
                            left-margin: 6;
                            right-margin: 6;
                            styles ["note-text"]
                          }

                          // The notes linking to this one, under its text (`show_backlinks`).
                          Gtk.Box backlinks_box {
                            orientation: vertical;
                            spacing: 12;
                            visible: false;

                            Gtk.Label backlinks_title {
                              xalign: 0;
                              margin-start: 6;
                              styles ["heading"]
                            }

                            Gtk.ListBox backlinks {
                              selection-mode: none;
                              styles ["boxed-list"]
                            }
                          }
                        }
                      }
                    }
                  };
                }
              };
            };
          };
        };
      }
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split.collapsed: true;
    }
  }
}

menu view_menu {
  section {
    item {
      custom: "zoom";
    }
  }

  section {
    item (_("Full Width"), "win.full-width")
  }
}

menu main_menu {
  item (_("Preferences"), "win.preferences")
  item (_("Keyboard Shortcuts"), "app.shortcuts")
  item (_("About Notav"), "app.about")
  item (_("Quit"), "app.quit")
}

menu login_menu {
  item (_("Copy Login Link"), "win.copy-login")
  item (_("Sign In with Password…"), "win.password-login")
}
