using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  search-enabled: false;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Appearance");

      // Kept on this device only.
      Adw.ActionRow {
        title: _("Style");

        [suffix]
        Adw.ToggleGroup color_scheme {
          valign: center;

          Adw.Toggle {
            name: "system";
            label: C_("style", "System");
          }

          Adw.Toggle {
            name: "light";
            label: C_("style", "Light");
          }

          Adw.Toggle {
            name: "dark";
            label: C_("style", "Dark");
          }
        }
      }

      // Kept on this device only.
      Adw.SwitchRow dense_tree {
        title: _("Dense tree");
        subtitle: _("Smaller rows, as in Files");
      }

      // Synced.
      Adw.ActionRow {
        title: _("Icons in tree");

        [suffix]
        Adw.ToggleGroup tree_icons {
          valign: center;

          Adw.Toggle {
            name: "all";
            label: C_("tree icons", "All");
          }

          Adw.Toggle {
            name: "notes";
            label: C_("tree icons", "Notes Only");
          }

          Adw.Toggle {
            name: "none";
            label: C_("tree icons", "None");
          }
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Editor");
    icon-name: "document-edit-symbolic";

    // Each mode's font, kept on this device only (fonts differ between them); each row's undo
    // button takes it back to the default (`settings::connect_font`).
    Adw.PreferencesGroup {
      title: _("Fonts");

      Adw.ActionRow {
        title: _("Editor mode");

        [suffix]
        Gtk.Button editor_font_default {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use the Default Font");
          valign: center;
          styles ["flat"]
        }

        [suffix]
        Gtk.FontDialogButton editor_font {
          valign: center;
          level: font;

          dialog: Gtk.FontDialog {
            title: _("Editor Mode Font");
          };
        }
      }

      Adw.ActionRow {
        title: _("Source mode");

        [suffix]
        Gtk.Button source_font_default {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use the Default Font");
          valign: center;
          styles ["flat"]
        }

        // Monospace fonts only (filtered in code).
        [suffix]
        Gtk.FontDialogButton source_font {
          valign: center;
          level: font;

          dialog: Gtk.FontDialog {
            title: _("Source Mode Font");
          };
        }
      }
    }

    // What Editor mode does to the Markdown by itself, each to turn off (synced).
    Adw.PreferencesGroup {
      title: _("Markdown");

      Adw.SwitchRow format_tables {
        title: _("Format tables");
        subtitle: _("Line up a table’s columns when the cursor leaves a changed row");
      }
    }
  }

  // The journal's daily notes (synced settings, `notav_core::journal`); each field is saved
  // with its apply button.
  Adw.PreferencesPage {
    title: _("Journal");
    icon-name: "notav-today-symbolic";

    Adw.PreferencesGroup {
      title: _("Daily Notes");
      description: _("A new daily note is a copy of the template note, with {{title}} and {{date}} in it filled in.");

      // Suggests the folders there are; another one is made.
      Adw.EntryRow journal_folder {
        title: _("Folder");
        show-apply-button: true;
      }

      // Suggests the notes there are.
      Adw.EntryRow journal_template {
        title: _("Template note");
        show-apply-button: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Note Name");
      description: _("YYYY is the year, YY its last two digits, MM the month and DD the day; M and D are without a leading zero. A / starts a folder, and text in [brackets] stays as written.");

      Adw.EntryRow journal_format {
        title: _("Format");
        show-apply-button: true;
      }

      Adw.ActionRow journal_preview {
        title: _("Today’s note");
        subtitle-selectable: true;
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Accounts");
    icon-name: "system-users-symbolic";

    // The status row, then the shared connection rows (ui/connection.blp).
    Adw.PreferencesGroup account {
      title: _("Account");

      // How Notav is connected now. Signed in here: "Sign Out", with signing in again in its
      // menu. Not connected: "Sign In with Browser". A GOA account is managed in GNOME Settings.
      Adw.ActionRow status {
        [prefix]
        Gtk.Image status_icon {
          icon-name: "object-select-symbolic";
          styles ["success"]
        }

        [suffix]
        Gtk.Button cancel_sign_in {
          label: _("Cancel");
          valign: center;
          visible: false;
          styles ["flat"]
        }

        [suffix]
        Adw.SplitButton sign_out {
          label: _("Sign Out");
          menu-model: sign_out_menu;
          dropdown-tooltip: _("Sign In Again");
          valign: center;
          styles ["destructive-action"]
        }

        [suffix]
        Adw.SplitButton sign_in {
          label: _("Sign In with Browser");
          menu-model: sign_in_menu;
          dropdown-tooltip: _("More Sign-In Options");
          valign: center;
        }
      }
    }

    // The notes folder (synced); another one asks whether to move the notes there.
    Adw.PreferencesGroup notes {
      title: _("Notes");

      Adw.EntryRow notes_folder {
        title: _("Notes folder in Nextcloud Files");
        show-apply-button: true;
      }
    }

    Adw.PreferencesGroup sync {
      title: _("Sync");

      Adw.SwitchRow sync_settings {
        title: _("Sync settings with server");
        subtitle: _("The Nextcloud server always stays on this device");
        active: true;
      }
    }
  }
}

menu sign_out_menu {
  item (_("Sign In Again"), "account.sign-in")
  item (_("Copy Login Link"), "account.sign-in-copy")
  item (_("Sign In with Password…"), "account.sign-in-password")
}

menu sign_in_menu {
  item (_("Copy Login Link"), "account.sign-in-copy")
  item (_("Sign In with Password…"), "account.sign-in-password")
}
