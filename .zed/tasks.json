// Run the Linux app straight from the workspace, without `make install`.
// The app is single-instance: if another copy (installed or a previous run) owns
// the bus name, a new launch just forwards to it. Quit it first with the task below.
[
  {
    "label": "linux: run",
    "command": "cargo run -p notav-linux",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run (release)",
    "command": "cargo run --release -p notav-linux",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run with debug logs",
    "command": "cargo run -p notav-linux",
    "env": { "G_MESSAGES_DEBUG": "all", "RUST_BACKTRACE": "1" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run in browser (Broadway)",
    // In make, not here: Zed runs commands through the user's shell (fish), not sh.
    "command": "make -C linux broadway",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run in sandbox",
    // Own data and keyring entries, next to the normal app: for testing other connections.
    "command": "make -C linux sandbox",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: reset sandbox",
    "command": "make -C linux sandbox-reset",
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "linux: quit running instance",
    // --auto-start=no so this never D-Bus-activates an installed copy just to quit it.
    "command": "busctl --user --auto-start=no call io.github.selfref.Notav /io/github/selfref/Notav org.gtk.Actions Activate 'sava{sv}' quit 0 0 || true",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  }
]
