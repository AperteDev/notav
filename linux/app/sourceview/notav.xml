<?xml version="1.0" encoding="UTF-8"?>
<!-- Adwaita's colours for prose rather than code, as Iotas styles its notes: headings sized by
     level, the Markdown marks dimmed, links in blue. -->
<style-scheme id="notav" name="Notav" parent-scheme="Adwaita" version="1.0">
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">notav-dark</property>
  </metadata>

  <style name="notav-markdown:heading1"       foreground="#3D3846" bold="true" scale="1.5"/>
  <style name="notav-markdown:heading2"       foreground="#3D3846" bold="true" scale="1.3"/>
  <style name="notav-markdown:heading3"       foreground="#3D3846" bold="true" scale="1.15"/>
  <style name="notav-markdown:heading4"       foreground="#3D3846" bold="true" scale="1.05"/>
  <style name="notav-markdown:heading5"       foreground="#3D3846" bold="true"/>
  <style name="notav-markdown:heading6"       foreground="#3D3846" bold="true"/>
  <style name="notav-markdown:heading-markup" foreground="#9A9996"/>

  <!-- Setext underlines, and "#tag" at the start of a line. -->
  <style name="markdown:header"               foreground="#9A9996" bold="true"/>
  <style name="markdown:list-marker"          foreground="#9A9996" bold="true"/>
  <style name="markdown:blockquote-marker"    foreground="#9A9996" bold="true"/>
  <style name="markdown:horizontal-rule"      foreground="#9A9996" bold="true"/>
  <style name="markdown:image-marker"         foreground="#9A9996" bold="true"/>
  <style name="markdown:link-text"            foreground="#1C71D8"/>
  <style name="markdown:url"                  foreground="#9A9996" italic="true" underline="low"/>

  <!-- Editor mode (src/editor.rs), headings as above. -->
  <style name="notav-editor:strong"           bold="true"/>
  <style name="notav-editor:emphasis"         italic="true"/>
  <style name="notav-editor:strikethrough"    strikethrough="true"/>
  <style name="notav-editor:code"             background="#EDEDEB"/>
  <style name="notav-editor:code-block"       line-background="#F6F5F4"/>
  <style name="notav-editor:quote"            foreground="#5E5C64"/>
  <style name="notav-editor:link"             foreground="#1C71D8" underline="single"/>
  <style name="notav-editor:list-mark"        foreground="#9A9996" bold="true"/>
  <style name="notav-editor:task"             foreground="#1C71D8" bold="true"/>
  <style name="notav-editor:table-header"     bold="true"/>
  <style name="notav-editor:mark"             foreground="#9A9996"/>
</style-scheme>
